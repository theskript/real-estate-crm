# Only needed if you're using real Supabase (not the SQLite fallback) and want
# to run migrations (scripts/migrate.cjs --target=postgres) instead of pasting
# them into the SQL Editor by hand. This file is gitignored — never commit
# real credentials here.
#
# Get this from Supabase → "Connect" button (top of dashboard) → Connection
# String tab → Session pooler (NOT "Direct connection" — that's IPv6-only and
# won't resolve on most networks). Swap in your real DB password.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
