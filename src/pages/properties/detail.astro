---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Property Detail" activeNav="properties">
  <div class="p-4 sm:p-6 lg:p-8 max-w-screen-2xl">
    <a href="/properties" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-800 mb-4 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Properties
    </a>

    <div id="not-found" class="hidden bg-white rounded-2xl border border-neutral-200 p-10 text-center text-neutral-400">Property not found.</div>

    <div id="content" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="lg:col-span-2 space-y-4">
        <div class="bg-white rounded-2xl border border-neutral-200 p-5">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div>
              <h1 id="p-address" class="text-xl font-display font-bold text-neutral-900">Loading…</h1>
              <p id="p-location" class="text-sm text-neutral-400"></p>
            </div>
            <select id="f-status" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm font-semibold bg-white">
              <option value="active">Active</option>
              <option value="pending">Pending</option>
              <option value="sold">Sold</option>
              <option value="off_market">Off Market</option>
            </select>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-neutral-100 text-sm">
            <div><div class="text-[10px] font-semibold uppercase text-neutral-400">Price</div><div id="p-price" class="font-semibold text-neutral-800">—</div></div>
            <div><div class="text-[10px] font-semibold uppercase text-neutral-400">Beds</div><div id="p-beds" class="font-semibold text-neutral-800">—</div></div>
            <div><div class="text-[10px] font-semibold uppercase text-neutral-400">Baths</div><div id="p-baths" class="font-semibold text-neutral-800">—</div></div>
            <div><div class="text-[10px] font-semibold uppercase text-neutral-400">Sqft</div><div id="p-sqft" class="font-semibold text-neutral-800">—</div></div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-neutral-200 p-5">
          <h2 class="text-sm font-semibold text-neutral-900 mb-2">Description</h2>
          <p id="p-description" class="text-sm text-neutral-600">—</p>
        </div>
      </div>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl border border-neutral-200 p-5">
          <h2 class="text-sm font-semibold text-neutral-900 mb-2">Seller Lead</h2>
          <div id="p-seller">—</div>
        </div>

        <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100">
            <h2 class="text-sm font-semibold text-neutral-900">Interested Buyers</h2>
            <button id="add-match-btn" class="text-xs font-semibold text-primary-600 hover:text-primary-700">+ Add</button>
          </div>
          <div id="match-form" class="hidden px-5 py-4 border-b border-neutral-100 bg-neutral-50 space-y-2">
            <select id="m-lead" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm bg-white"></select>
            <div class="flex justify-end gap-2">
              <button id="cancel-match-btn" class="px-3 py-1.5 text-xs font-medium text-neutral-500">Cancel</button>
              <button id="save-match-btn" class="px-3 py-1.5 text-xs font-semibold bg-primary-600 hover:bg-primary-700 text-white rounded-lg">Add</button>
            </div>
          </div>
          <div id="matches-list" class="divide-y divide-neutral-50">
            <div class="px-5 py-6 text-center text-neutral-400 text-sm">Loading…</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { requireLogin, apiFetch, esc } from '../../scripts/auth.js';
    requireLogin();
    const propertyId = new URLSearchParams(location.search).get('id');
    if (!propertyId) location.href = '/properties';

    async function patchProperty(fields: any) {
      await apiFetch('properties', { method: 'PATCH', params: { id: propertyId }, body: fields });
    }

    function renderMatches(matches: any[]) {
      document.getElementById('matches-list')!.innerHTML = matches.length ? matches.map(m => `
        <div class="flex items-center justify-between px-5 py-3">
          <a href="/leads/detail?id=${m.lead.id}" class="text-sm font-medium text-neutral-800 hover:text-primary-600 truncate">${esc(m.lead.first_name + ' ' + (m.lead.last_name || ''))}</a>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-600 capitalize">${m.status.replace('_',' ')}</span>
        </div>`).join('') : `<div class="px-5 py-6 text-center text-neutral-400 text-sm">No interested buyers yet</div>`;
    }

    async function load() {
      let property;
      try {
        const res = await apiFetch('properties', { params: { id: propertyId } });
        property = res.property;
      } catch {
        document.getElementById('not-found')?.classList.remove('hidden');
        return;
      }
      document.getElementById('content')?.classList.remove('hidden');
      document.getElementById('p-address')!.textContent = property.address;
      document.getElementById('p-location')!.textContent = [property.city, property.state, property.zip].filter(Boolean).join(', ');
      (document.getElementById('f-status') as HTMLSelectElement).value = property.status;
      document.getElementById('p-price')!.textContent = property.price ? '$' + Number(property.price).toLocaleString() : '—';
      document.getElementById('p-beds')!.textContent = property.beds ?? '—';
      document.getElementById('p-baths')!.textContent = property.baths ?? '—';
      document.getElementById('p-sqft')!.textContent = property.sqft ? Number(property.sqft).toLocaleString() : '—';
      document.getElementById('p-description')!.textContent = property.description || 'No description yet.';
      document.getElementById('p-seller')!.innerHTML = property.seller_lead
        ? `<a href="/leads/detail?id=${property.seller_lead.id}" class="text-sm text-primary-600 hover:underline">${esc(property.seller_lead.first_name + ' ' + (property.seller_lead.last_name || ''))}</a>`
        : '<span class="text-sm text-neutral-400">Not linked to a seller lead</span>';
      renderMatches(property.matches || []);
    }
    load();

    document.getElementById('f-status')?.addEventListener('change', async (e: any) => { await patchProperty({ status: e.target.value }); });

    const matchForm = document.getElementById('match-form');
    document.getElementById('add-match-btn')?.addEventListener('click', async () => {
      matchForm?.classList.toggle('hidden');
      const { leads } = await apiFetch('leads', { params: { lead_type: 'buyer' } });
      (document.getElementById('m-lead') as HTMLSelectElement).innerHTML = leads.map((l: any) => `<option value="${l.id}">${esc(l.first_name + ' ' + (l.last_name || ''))}</option>`).join('');
    });
    document.getElementById('cancel-match-btn')?.addEventListener('click', () => matchForm?.classList.add('hidden'));
    document.getElementById('save-match-btn')?.addEventListener('click', async () => {
      const leadId = (document.getElementById('m-lead') as HTMLSelectElement).value;
      if (!leadId) return;
      await apiFetch('lead-property-matches', { method: 'POST', body: { lead_id: leadId, property_id: propertyId } });
      matchForm?.classList.add('hidden');
      load();
    });
  </script>
</AdminLayout>
