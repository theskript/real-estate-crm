---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Properties" activeNav="properties">
  <div class="p-4 sm:p-6 lg:p-8 max-w-screen-2xl">
    <div class="flex items-start justify-between gap-4 mb-5 flex-wrap">
      <div>
        <h1 class="text-2xl font-display font-bold text-neutral-900">Properties</h1>
        <p id="count-label" class="text-sm text-neutral-400 mt-0.5">Loading…</p>
      </div>
      <button id="open-compose-btn" class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Property
      </button>
    </div>

    <div class="bg-white rounded-xl border border-neutral-200 p-3 mb-5 flex flex-wrap gap-2 items-center">
      <input id="f-search" type="text" placeholder="Search address, city, zip…" class="flex-1 min-w-[180px] px-3 py-2 rounded-lg border border-neutral-200 text-sm outline-none" />
      <select id="f-status" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm bg-white">
        <option value="">All Statuses</option>
        <option value="active">Active</option>
        <option value="pending">Pending</option>
        <option value="sold">Sold</option>
        <option value="off_market">Off Market</option>
      </select>
    </div>

    <div id="property-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="col-span-full text-center text-neutral-400 py-10">Loading…</div>
    </div>
  </div>

  <!-- Add Property panel -->
  <div id="compose-overlay" class="hidden fixed inset-0 bg-black/30 z-40"></div>
  <div id="compose-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-[440px] bg-white shadow-2xl border-l border-neutral-200 z-50 flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 class="font-semibold text-neutral-900">Add Property</h3>
      <button id="close-compose-btn" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-6 space-y-3">
      <input id="c-address" placeholder="Street address *" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
      <div class="grid grid-cols-3 gap-2">
        <input id="c-city" placeholder="City" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
        <input id="c-state" placeholder="State" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
        <input id="c-zip" placeholder="Zip" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
      </div>
      <div class="grid grid-cols-2 gap-2">
        <input id="c-price" type="number" placeholder="Price" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
        <select id="c-status" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm bg-white">
          <option value="active">Active</option>
          <option value="pending">Pending</option>
          <option value="sold">Sold</option>
          <option value="off_market">Off Market</option>
        </select>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <input id="c-beds" type="number" placeholder="Beds" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
        <input id="c-baths" type="number" step="0.5" placeholder="Baths" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
        <input id="c-sqft" type="number" placeholder="Sqft" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm" />
      </div>
      <select id="c-seller-lead" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm bg-white">
        <option value="">No linked seller lead</option>
      </select>
      <textarea id="c-description" rows="3" placeholder="Description" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm"></textarea>
      <div id="compose-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2"></div>
    </div>
    <div class="px-6 py-4 border-t border-neutral-100 shrink-0">
      <button id="save-compose-btn" class="w-full py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl text-sm">Save Property</button>
    </div>
  </div>

  <script>
    import { requireLogin, apiFetch, esc } from '../../scripts/auth.js';

    requireLogin();
    const STATUS_BADGE: Record<string, string> = {
      active: 'bg-emerald-100 text-emerald-700', pending: 'bg-amber-100 text-amber-700',
      sold: 'bg-neutral-800 text-white', off_market: 'bg-neutral-100 text-neutral-500',
    };

    function propertyCard(p: any) {
      return `
        <a href="/properties/detail?id=${p.id}" class="block bg-white rounded-2xl border border-neutral-200 overflow-hidden hover:shadow-md hover:border-neutral-300 transition-all">
          <div class="h-32 bg-gradient-to-br from-primary-100 to-primary-50 flex items-center justify-center text-primary-300">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-3 0v-6H9v6"/></svg>
          </div>
          <div class="p-4">
            <div class="flex items-center justify-between mb-1">
              <span class="text-lg font-bold text-neutral-900">${p.price ? '$' + Number(p.price).toLocaleString() : 'Price TBD'}</span>
              <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full capitalize ${STATUS_BADGE[p.status] || 'bg-neutral-100 text-neutral-500'}">${p.status.replace('_',' ')}</span>
            </div>
            <div class="text-sm text-neutral-700 truncate">${esc(p.address)}</div>
            <div class="text-xs text-neutral-400 truncate">${esc([p.city, p.state, p.zip].filter(Boolean).join(', '))}</div>
            <div class="flex items-center gap-3 mt-2 text-xs text-neutral-500">
              ${p.beds ? `<span>${p.beds} bd</span>` : ''}${p.baths ? `<span>${p.baths} ba</span>` : ''}${p.sqft ? `<span>${Number(p.sqft).toLocaleString()} sqft</span>` : ''}
            </div>
          </div>
        </a>`;
    }

    async function load() {
      const query: Record<string, string> = {
        search: (document.getElementById('f-search') as HTMLInputElement).value,
        status: (document.getElementById('f-status') as HTMLSelectElement).value,
      };
      const { properties } = await apiFetch('properties', { params: query });
      document.getElementById('count-label')!.textContent = `${properties.length} propert${properties.length === 1 ? 'y' : 'ies'}`;
      document.getElementById('property-grid')!.innerHTML = properties.length
        ? properties.map(propertyCard).join('')
        : `<div class="col-span-full text-center text-neutral-400 py-10">No properties match your filters</div>`;
    }
    let t: any;
    document.getElementById('f-search')?.addEventListener('input', () => { clearTimeout(t); t = setTimeout(load, 300); });
    document.getElementById('f-status')?.addEventListener('change', load);
    load();

    // Compose panel
    const overlay = document.getElementById('compose-overlay');
    const panel = document.getElementById('compose-panel');
    async function openCompose() {
      overlay?.classList.remove('hidden'); panel?.classList.remove('hidden');
      document.getElementById('compose-error')?.classList.add('hidden');
      try {
        const { leads } = await apiFetch('leads', { params: { lead_type: 'seller' } });
        const sel = document.getElementById('c-seller-lead') as HTMLSelectElement;
        sel.innerHTML = '<option value="">No linked seller lead</option>' + leads.map((l: any) => `<option value="${l.id}">${esc(l.first_name + ' ' + (l.last_name || ''))}</option>`).join('');
      } catch {}
    }
    function closeCompose() { overlay?.classList.add('hidden'); panel?.classList.add('hidden'); }
    document.getElementById('open-compose-btn')?.addEventListener('click', openCompose);
    document.getElementById('close-compose-btn')?.addEventListener('click', closeCompose);
    overlay?.addEventListener('click', closeCompose);

    document.getElementById('save-compose-btn')?.addEventListener('click', async () => {
      const errorEl = document.getElementById('compose-error')!;
      const address = (document.getElementById('c-address') as HTMLInputElement).value.trim();
      if (!address) { errorEl.textContent = 'Address is required.'; errorEl.classList.remove('hidden'); return; }
      const body: any = {
        address,
        city: (document.getElementById('c-city') as HTMLInputElement).value.trim() || null,
        state: (document.getElementById('c-state') as HTMLInputElement).value.trim() || null,
        zip: (document.getElementById('c-zip') as HTMLInputElement).value.trim() || null,
        price: (document.getElementById('c-price') as HTMLInputElement).value || null,
        status: (document.getElementById('c-status') as HTMLSelectElement).value,
        beds: (document.getElementById('c-beds') as HTMLInputElement).value || null,
        baths: (document.getElementById('c-baths') as HTMLInputElement).value || null,
        sqft: (document.getElementById('c-sqft') as HTMLInputElement).value || null,
        seller_lead_id: (document.getElementById('c-seller-lead') as HTMLSelectElement).value || null,
        description: (document.getElementById('c-description') as HTMLTextAreaElement).value.trim() || null,
      };
      try {
        await apiFetch('properties', { method: 'POST', body });
        closeCompose();
        load();
      } catch (err: any) {
        errorEl.textContent = err.message;
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</AdminLayout>
