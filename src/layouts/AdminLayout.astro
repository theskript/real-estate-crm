---
export interface Props {
  title: string;
  activeNav?: 'dashboard' | 'leads' | 'tasks' | 'calendar' | 'properties' | 'agents' | 'audit' | 'settings';
}
const { title, activeNav } = Astro.props;

const NAV_ITEMS: Array<{ id: string; label: string; href: string; ownerOnly?: boolean; icon: string }> = [
  { id: 'dashboard', label: 'Dashboard', href: '/', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { id: 'leads', label: 'Leads', href: '/leads', icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4' },
  { id: 'tasks', label: 'Tasks', href: '/tasks', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4' },
  { id: 'calendar', label: 'Calendar', href: '/calendar', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { id: 'properties', label: 'Properties', href: '/properties', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-3 0v-6H9v6' },
  { id: 'agents', label: 'Agents', href: '/agents', ownerOnly: true, icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm0 0v0' },
  { id: 'audit', label: 'Audit Log', href: '/audit', ownerOnly: true, icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { id: 'settings', label: 'Settings', href: '/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Teaka CRM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
  <meta name="robots" content="noindex, nofollow" />
  <style>
    #sidebar { transition: width 200ms cubic-bezier(.4,0,.2,1); }
    #main-content { transition: margin-left 200ms cubic-bezier(.4,0,.2,1); }
    .sb-label { transition: opacity 120ms ease, max-width 200ms ease; white-space: nowrap; overflow: hidden; }
    #sidebar.sb-open  .sb-label { opacity: 1; max-width: 200px; }
    #sidebar.sb-closed .sb-label { opacity: 0; max-width: 0; pointer-events: none; }
    #sidebar.sb-closed .nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
    #sidebar.sb-open  #brand-text { opacity: 1; max-width: 200px; }
    #sidebar.sb-closed #brand-text { opacity: 0; max-width: 0; overflow: hidden; }
    #sb-toggle svg { transition: transform 200ms ease; }
    #sidebar.sb-closed #sb-toggle svg { transform: rotate(180deg); }
    #sidebar.sb-open  #user-footer-detail { display: block; }
    #sidebar.sb-closed #user-footer-detail { display: none; }
    #sidebar.sb-open  [data-tip]::after { display: none; }
    #sidebar.sb-closed [data-tip]:hover::after {
      content: attr(data-tip); position: absolute; left: calc(100% + 10px); top: 50%;
      transform: translateY(-50%); background: #1e293b; color: #f8fafc; font-size: 11px;
      font-weight: 500; padding: 4px 8px; border-radius: 6px; white-space: nowrap;
      z-index: 100; pointer-events: none;
    }
    @media (max-width: 1023px) {
      #main-content { margin-left: 0 !important; max-width: 100vw; overflow-x: hidden; padding-bottom: 2rem; }
      body { overflow-x: hidden; }
      .fixed.inset-y-0.right-0 { width: 100% !important; max-width: 100vw; }
    }
  </style>
  <script>
    (function () {
      try {
        const token = localStorage.getItem('teaka_token');
        if (!token) throw new Error('no token');
        const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));
        if (!payload.exp || payload.exp < Date.now() / 1000) throw new Error('expired');
      } catch {
        document.documentElement.style.display = 'none';
        window.location.replace('/login');
      }
    })();
  </script>
</head>
<body class="bg-neutral-100 font-sans min-h-screen">

  <!-- Mobile top bar -->
  <div class="lg:hidden flex items-center justify-between bg-neutral-900 px-4 py-3 sticky top-0 z-40">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-lg bg-primary-500 flex items-center justify-center shrink-0">
        <span class="text-white text-xs font-bold font-display">T</span>
      </div>
      <span class="font-semibold text-sm text-white">Teaka</span>
    </div>
    <button id="mobile-menu-btn" class="p-2 rounded-lg text-neutral-400 hover:text-white hover:bg-white/10 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile drawer overlay -->
  <div id="mobile-overlay" class="hidden lg:hidden fixed inset-0 bg-black/40 z-40"></div>

  <div class="flex">
    <!-- Sidebar -->
    <aside id="sidebar" class="hidden lg:flex flex-col bg-neutral-900 fixed top-0 left-0 z-50 h-screen sb-open" style="width:13rem">
      <div class="flex items-center gap-2 px-3 py-4 border-b border-white/[0.07] shrink-0">
        <div class="w-7 h-7 rounded-lg bg-primary-500 flex items-center justify-center shrink-0">
          <span class="text-white text-xs font-bold font-display">T</span>
        </div>
        <div id="brand-text" class="sb-label min-w-0">
          <div class="text-[11px] font-semibold text-white leading-tight truncate">Teaka</div>
          <div class="text-[10px] text-neutral-500 truncate">Real Estate CRM</div>
        </div>
        <button id="sb-toggle" class="ml-auto p-1 rounded text-neutral-600 hover:text-neutral-300 transition-colors shrink-0 hidden lg:block" title="Toggle sidebar">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
          </svg>
        </button>
        <button id="mobile-close-btn" class="ml-auto p-1 rounded text-neutral-400 lg:hidden">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <nav class="flex-1 px-2 py-3 flex flex-col gap-0.5 overflow-y-auto" id="agent-only-nav">
        <a href="/leads?compose=1" class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-xs font-semibold transition-colors mb-2 bg-primary-600/25 text-primary-300 hover:bg-primary-500/40 hover:text-white" data-tip="Add Lead">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span class="sb-label">Add Lead</span>
        </a>
        {NAV_ITEMS.map(item => (
          <a href={item.href} data-tip={item.label} data-owner-only={item.ownerOnly ? '1' : undefined}
             class={`nav-link flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-xs font-medium transition-colors ${activeNav === item.id ? 'bg-white/10 text-white font-semibold' : 'text-neutral-400 hover:text-white hover:bg-white/[0.07]'}`}>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/></svg>
            <span class="sb-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="px-3 py-3 border-t border-white/[0.07] shrink-0">
        <div class="flex items-center gap-2">
          <div id="user-avatar" class="w-7 h-7 rounded-full bg-primary-600 flex items-center justify-center text-[10px] font-bold text-white shrink-0">–</div>
          <div id="user-footer-detail" class="min-w-0">
            <div id="user-name" class="text-xs font-semibold text-white truncate">–</div>
            <div id="user-role" class="text-[10px] text-neutral-500 truncate capitalize">–</div>
          </div>
          <button id="logout-btn" class="ml-auto p-1.5 rounded text-neutral-500 hover:text-white hover:bg-white/10 transition-colors shrink-0" title="Sign out">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <div id="main-content" class="flex-1 min-w-0" style="margin-left:13rem">
      <slot />
    </div>
  </div>

  <script>
    import { requireLogin, getRole, getName, clearAuth, initials } from '../scripts/auth.js';
    requireLogin();

    const role = getRole();
    const name = getName();
    const nameEl = document.getElementById('user-name');
    const roleEl = document.getElementById('user-role');
    const avatarEl = document.getElementById('user-avatar');
    if (nameEl) nameEl.textContent = name || 'User';
    if (roleEl) roleEl.textContent = role || '';
    if (avatarEl) avatarEl.textContent = initials(name);

    // Hide owner-only nav items for agents
    if (role !== 'owner') {
      document.querySelectorAll('[data-owner-only="1"]').forEach(el => el.remove());
    }

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      clearAuth();
      window.location.href = '/login';
    });

    // Desktop collapse toggle
    const sidebar = document.getElementById('sidebar');
    const main = document.getElementById('main-content');
    const toggleBtn = document.getElementById('sb-toggle');
    function applyWidth(open: boolean) {
      if (!sidebar || !main) return;
      sidebar.style.width = open ? '13rem' : '4.5rem';
      main.style.marginLeft = window.innerWidth >= 1024 ? (open ? '13rem' : '4.5rem') : '0';
      sidebar.classList.toggle('sb-open', open);
      sidebar.classList.toggle('sb-closed', !open);
    }
    let sbOpen = localStorage.getItem('teaka_sb_open') !== '0';
    applyWidth(sbOpen);
    toggleBtn?.addEventListener('click', () => {
      sbOpen = !sbOpen;
      localStorage.setItem('teaka_sb_open', sbOpen ? '1' : '0');
      applyWidth(sbOpen);
    });

    // Mobile drawer
    const overlay = document.getElementById('mobile-overlay');
    function openMobile() {
      sidebar?.classList.remove('hidden');
      sidebar?.classList.add('flex');
      if (sidebar) sidebar.style.width = '16rem';
      overlay?.classList.remove('hidden');
    }
    function closeMobile() {
      sidebar?.classList.add('hidden');
      sidebar?.classList.remove('flex');
      overlay?.classList.add('hidden');
      if (window.innerWidth >= 1024) applyWidth(sbOpen);
    }
    document.getElementById('mobile-menu-btn')?.addEventListener('click', openMobile);
    document.getElementById('mobile-close-btn')?.addEventListener('click', closeMobile);
    overlay?.addEventListener('click', closeMobile);
    window.addEventListener('resize', () => { if (window.innerWidth >= 1024) closeMobile(); });
  </script>
</body>
</html>
