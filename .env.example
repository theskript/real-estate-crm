# ── Supabase ──────────────────────────────────────────────────────────────────
# Leave these blank (or delete them) to run entirely on the local SQLite
# fallback instead — see README "Quick start (no Supabase account needed)".
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Force a specific database backend. Leave unset to auto-detect (uses
# Supabase if the vars above are set, otherwise falls back to local SQLite).
# DB_PROVIDER=sqlite

# ── Auth ──────────────────────────────────────────────────────────────────────
# Any long random string — used to sign admin session JWTs. Generate with:
#   openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Twilio (future dialer — leave blank until you're ready to wire it up) ─────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
