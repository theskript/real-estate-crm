# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Auth ──────────────────────────────────────────────────────────────────────
# Any long random string — used to sign admin session JWTs. Generate with:
#   openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Bootstrap owner login, used only until the first "owner" row exists in the
# agents table (see README "First login" section).
ADMIN_PASSWORD=CHANGE_ME

# ── Twilio (future dialer — leave blank until you're ready to wire it up) ─────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
